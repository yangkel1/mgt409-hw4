# Copy to .env and fill in real values. Never commit the real .env.

# --- Portkey ---
PORTKEY_API_KEY=pk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# --- Models ---
# Cheap default for most turns; step up only if a step needs it.
MODEL_DEFAULT=gpt-5.6-luna
MODEL_AGENT=gpt-5.6-luna

# --- Auth ---
# Long random string that signs login cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Paths (relative to hw4/) ---
DATA_DIR=./data
DB_PATH=./data/campus_customs.db
